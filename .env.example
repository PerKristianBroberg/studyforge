ANTHROPIC_API_KEY=

# optional: local Langfuse tracing (self-hosted; notes never leave this PC)
LANGFUSE_PUBLIC_KEY=pk-lf-<uuid>
LANGFUSE_SECRET_KEY=sk-lf-<uuid>
LANGFUSE_HOST=http://127.0.0.1:3000
# headless init for infra/langfuse — must match the keys above
LANGFUSE_INIT_ORG_ID=studyforge
LANGFUSE_INIT_ORG_NAME=studyforge
LANGFUSE_INIT_PROJECT_ID=studyforge
LANGFUSE_INIT_PROJECT_NAME=studyforge
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<uuid>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<uuid>
LANGFUSE_INIT_USER_EMAIL=me@studyforge.local
LANGFUSE_INIT_USER_NAME=me
LANGFUSE_INIT_USER_PASSWORD=

# set to 1 after the first run: models are cached, skip the online update check on every start
# HF_HUB_OFFLINE=1
